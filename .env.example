# Mealie MCP Server Configuration
# Copy this file to .env and fill in your values

# Mealie instance URL (no trailing slash)
MEALIE_URL=https://your-mealie-instance.com

# API token from Mealie (User Settings > API Tokens)
# This token also doubles as the MCP endpoint's bearer secret - it must be
# sent as `Authorization: Bearer <token>` on every request to the server.
MEALIE_API_TOKEN=your-api-token-here

# Host/port the MCP server binds to (optional, defaults shown)
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
